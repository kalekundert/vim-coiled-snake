" Minimal vimrc for automated and manual testing.
let s:dir = expand('<sfile>:p:h')
execute 'set runtimepath^=' .. s:dir .. '/..'
filetype plugin indent on
set cpoptions-=C

" These options are only to make visual debugging easier; they should not 
" affect the automated tests.
set foldcolumn=5
set signcolumn=yes
set number

